<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ===== Development: colored console output ===== -->
    <springProfile name="local,test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) [%X{requestId:-no-req}] %cyan(%logger{36}) - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <!-- Reduce noise from Hibernate SQL in local dev -->
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.flywaydb" level="INFO"/>
        <logger name="com.tanda" level="DEBUG"/>
    </springProfile>

    <!-- ===== Production: structured JSON output ===== -->
    <springProfile name="prod">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <!-- Structured key=value pairs readable by log aggregators -->
                <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}","level":"%level","requestId":"%X{requestId:-}","logger":"%logger{36}","message":"%replace(%msg){'\"','\\\"'}","thread":"%thread"}%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>

        <logger name="com.tanda" level="INFO"/>
    </springProfile>

</configuration>
