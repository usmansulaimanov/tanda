{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tandamen.kz/dev-api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://tandamen.kz/dev-uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
